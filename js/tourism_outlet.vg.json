{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bubble chart: Tourism arrivals vs McDonald's outlet count by state, with hover highlighting and category filter",
  "width": 700,
  "height": 550,
  "padding": { "top": 20, "bottom": 10 },
  "params": [
    {
      "name": "categoryFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "<5M", "5M-15M", ">15M"],
        "name": "Filter by Tourism Category: "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/ZoeOungZiYing/FIT3179-HW10/main/data/tourism_outlets.csv"
  },
  "transform": [
    {
      "calculate": "datum.tourism_arrivals_2022 > 15000000 ? '>15M' : (datum.tourism_arrivals_2022 > 5000000 ? '5M-15M' : '<5M')",
      "as": "TourismCategory"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "categoryFilter == 'All' ? true : datum.TourismCategory == categoryFilter"
        }
      ],
      "params": [
        {
          "name": "hoverBubble",
          "select": { "type": "point", "on": "mouseover", "fields": ["state"] }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "tourism_arrivals_2022",
          "type": "quantitative",
          "title": "Tourism Arrivals (Millions)",
          "axis": {
            "labelFontSize": 14,
            "titleFontSize": 16
          }
        },
        "y": {
          "field": "outlet_count",
          "type": "quantitative",
          "title": "Outlet Count",
          "axis": {
            "labelFontSize": 14,
            "titleFontSize": 16
          }
        },
        "size": {
          "field": "outlet_count",
          "type": "quantitative",
          "title": "Outlet Count",
          "scale": { "range": [100, 2000] },
          "legend": {
            "titleFontSize": 14,
            "labelFontSize": 12,
            "titlePadding": 10
          }
        },
        "color": {
          "field": "TourismCategory",
          "type": "nominal",
          "title": "Tourism Category",
          "scale": {
            "domain": ["<5M", "5M-15M", ">15M"],
            "range": ["#1b9e77", "#d95f02", "#7570b3"]
          },
          "legend": {
            "orient": "right",
            "offset": 30,
            "padding": 8,
            "titleFontSize": 14,
            "labelFontSize": 12,
            "titlePadding": 10
          }
        },
        "fillOpacity": {
          "condition": { "param": "hoverBubble", "value": 1 },
          "value": 0.6
        },
        "strokeWidth": {
          "condition": { "param": "hoverBubble", "value": 3 },
          "value": 0.5
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State" },
          {
            "field": "tourism_arrivals_2022",
            "type": "quantitative",
            "title": "Tourism Arrivals",
            "format": ","
          },
          {
            "field": "outlet_count",
            "type": "quantitative",
            "title": "Outlet Count"
          },
          {
            "field": "TourismCategory",
            "type": "nominal",
            "title": "Tourism Category"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            { "op": "mean", "field": "outlet_count", "as": "avg_outlet" }
          ]
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#fdb462",
            "strokeDash": [4, 4],
            "size": 2
          },
          "encoding": {
            "y": { "field": "avg_outlet", "type": "quantitative" },
            "tooltip": [
              {
                "field": "avg_outlet",
                "type": "quantitative",
                "title": "Overall Average Outlet Count"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "dy": -10,
            "fontWeight": "bold",
            "color": "#fdb462",
            "fontSize": 16
          },
          "encoding": {
            "y": { "field": "avg_outlet", "type": "quantitative" },
            "text": { "value": "Average outlet count" }
          }
        }
      ]
    }
  ],
  "title": {
    "text": "",
    "fontSize": 20,
    "fontWeight": "bold",
    "offset": 10
  },
  "config": {
    "axis": { "labelFontSize": 12, "titleFontSize": 14 },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 14,
      "offset": 20,
      "padding": 10
    },
    "view": { "stroke": "transparent" }
  }
}
